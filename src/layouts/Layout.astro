---
const { title } = Astro.props;
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="icon" type="image/x-icon" href="/public/favicon.ico" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700&family=Inter:wght@300;400;500&display=swap"
    />
  </head>

  <body>
    <header>
      <nav class="nav">
        <a href="/" class="logo">FTC Team 32180</a>
        <a href="/about">About</a>
        <a href="/robot">Robot</a>
        <a href="/outreach">Outreach</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">© Orion | NorthStarRobotics</footer>
  </body>
</html>

<style>
  .nav {
    display: flex;
    gap: 1rem;
    padding: 1rem;
    background: var(--purple);
    color: white;
    align-items: center;
  }

  .logo {
    font-weight: bold;
    margin-right: auto;
    color: var(--highlight);
  }

  a {
    color: white;
    text-decoration: none;
  }

  a:hover {
    color: var(--highlight);
  }

  .footer {
    padding: 1rem;
    text-align: center;
    background: var(--purple);
    margin-top: 2rem;
  }
</style>
