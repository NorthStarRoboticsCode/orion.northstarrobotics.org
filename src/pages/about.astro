---
import BaseLayout from "../layouts/Layout.astro";
---

<BaseLayout title="About the Team">
    <!-- HERO -->
    <section class="hero">
        <div class="overlay">
            <h1>FTC Team 32180 — Orion | NorthStarRobotics</h1>
        </div>
    </section>

    <!-- PROGRAM DESCRIPTION -->
    <section class="angled">
        <h2>NorthStarRobotics</h2>
        <p>
            NorthStarRobotics is a program illuminating STEAM pathways for youth
            north of Indianapolis; helping them navigate the constellations of
            opportunity with curiosity, creativity, and integrity.
        </p>
    </section>

    <!-- TEAM DESCRIPTION -->
    <section class="angled">
        <h2>Orion | NorthStarRobotics</h2>
        <p>
            Orion, the first FTC team at NorthStarRobotics, draws its name from
            the legendary hunter whose constellation guides travelers across the
            night sky. Our students come together to navigate STEAM challenges
            with precision, resilience, and courage.
        </p>
    </section>

    <!-- MEET THE TEAM -->
    <section class="angled">
        <h2>Meet the Team</h2>
        <p>Learn more about the three branches that make Orion thrive.</p>
    </section>

    <!-- MECHANICAL -->
    <section class="angled">
        <h2>Mechanical</h2>
        <p>
            The Mechanical subteam designs the physical aspects of each year’s
            robot. They work closely with Programming to ensure effective final
            control systems.
        </p>

        <h3>Mechanical’s Responsibilities</h3>
        <div class="mini-cards">
            <div class="mini-card">CADing</div>
            <div class="mini-card">Prototyping</div>
            <div class="mini-card">Manufacturing</div>
            <div class="mini-card">Field Management</div>
        </div>
    </section>

    <!-- PROGRAMMING -->
    <section class="angled">
        <h2>Control</h2>
        <p>
            The Control subteam wires and codes all robot subsystems to perform
            required functions. They collaborate with Mechanical throughout the
            build season to ensure systems are reliable and effective. They also
            implement advanced control systems to enhance robot performance in
            all game stages.
        </p>

        <h3>Programming’s Responsibilities</h3>
        <div class="mini-cards">
            <div class="mini-card">Website Design & Maintenance</div>
            <div class="mini-card">Electrical Systems</div>
            <div class="mini-card">Subsystem Code</div>
            <div class="mini-card">Advanced Control Systems (PID)</div>
            <div class="mini-card">Computer Vision</div>
            <div class="mini-card">Autonomous Control</div>
        </div>
    </section>

    <!-- BUSINESS -->
    <section class="angled">
        <h2>Business</h2>
        <p>
            The Business subteam manages public relations and works diligently
            to submit awards. They provide the exposure our team needs to grow
            and develop.
        </p>

        <h3>Business’ Responsibilities</h3>
        <div class="mini-cards">
            <div class="mini-card">Social Media</div>
            <div class="mini-card">Sponsorships & Relations</div>
            <div class="mini-card">Awards & Portfolio</div>
            <div class="mini-card">Newsletters</div>
            <div class="mini-card">Merchandise & Graphic Design</div>
            <div class="mini-card">Team Image Coordination</div>
        </div>
    </section>
</BaseLayout>
